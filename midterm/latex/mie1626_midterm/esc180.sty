% Subquestions formatted with a header but with the question text on the same
% line.
\newlength\pikstsopnoitseuqbus
\newcommand*\subquestionnospace[2][]
   {\setlength\pikstsopnoitseuqbus{\subquestionpostskip}%
    \setlength\subquestionpostskip{-\subquestionsep}%
    \subquestion[#1]{#2}\mbox{}%
    \setlength\subquestionpostskip{\pikstsopnoitseuqbus}\ignorespaces}

